{
  "manifest_version": 3,
  "name": "YouTube Remote Control",
  "short_name": "youtube-remote-control",
  "description": "Control YouTube playing in your browser from your phone or another mobile device.",
  "version": "2.0.0",
  "icons": {
    "16": "assets/icons/16.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/16.png",
      "48": "assets/icons/48.png"
    },
    "default_title": "YouTube Remote Control",
    "default_popup": "popup/popup.html"
  },
  "permissions": ["webRequest", "webRequestBlocking"],
  "host_permissions": ["*://*.youtube.com/tv*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wrybread@sinkingsensation.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
