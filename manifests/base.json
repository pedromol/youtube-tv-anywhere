{
  "manifest_version": 3,
  "name": "YouTube Remote Control",
  "short_name": "youtube-remote-control",
  "description": "Control YouTube playing in your browser from your phone or another mobile device.",
  "icons": {
    "16": "assets/icons/16.png",
    "48": "assets/icons/48.png",
    "128": "assets/icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/16.png",
      "48": "assets/icons/48.png"
    },
    "default_title": "YouTube Remote Control",
    "default_popup": "popup/popup.html"
  }
}
